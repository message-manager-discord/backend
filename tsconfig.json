{
  "$schema": "https://json.schemastore.org/tsconfig",

  "compilerOptions": {
    "lib": ["es2025"],
    "target": "es2025",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "verbatimModuleSyntax": true,

    "strict": true,

    "rootDir": "src",
    "outDir": "dist",

    "sourceMap": true,

    "resolveJsonModule": true
  }
}
