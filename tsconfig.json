{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node 16",

  "compilerOptions": {
  "module": "nodenext",
    "target": "es2021",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "resolveJsonModule": true,
  "moduleResolution": "nodenext",
    "sourceMap": true,
    "outDir": "dist",
    "noEmitHelpers": true,
    "importHelpers": true
  }
}
