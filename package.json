{
  "name": "message-manager-backend",
  "version": "2.3.2",
  "description": "Backend for the message manager site",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./v1": "./dist/v1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "AnotherCat <anothercat1259@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "tsc",
    "build:production": "tsc -p ./tsconfig.production.json",
    "start": "node ./dist/index.js",
    "dev": "tsc-watch --noClear --onSuccess \"node ./dist/index.js\"",
    "go": "npm run build && npm run start",
    "test": "tap --ts --test-ignore=dist",
    "migrate": "prisma migrate deploy",
    "generate": "prisma generate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@discordjs/rest": "^2.4.3",
    "@fastify/auth": "^5.0.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@prisma/client": "^6.5.0",
    "@sentry/node": "^9.9.0",
    "@sinclair/typebox": "^0.34.31",
    "axios": "^1.8.4",
    "discord-interactions": "^4.1.1",
    "dotenv": "^16.4.7",
    "env-schema": "^6.0.1",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-raw-body": "^5.0.0",
    "form-data-encoder": "^4.0.2",
    "formdata-node": "^6.0.3",
    "fuse.js": "^7.1.0",
    "http-errors": "^2.0.0",
    "ioredis": "^5.6.0",
    "prisma-field-encryption": "^1.4.0",
    "prom-client": "^15.1.3",
    "redis-discord-cache": "github:message-manager-discord/redis-discord-cache",
    "tslib": "^2.4.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/http-errors": "^2.0.1",
    "@types/node": "^24.13.3",
    "@types/uuid": "^10.0.0",
    "discord-api-types": "^0.37.25",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.1",
    "tsc-watch": "^6.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "type": "module"
}
